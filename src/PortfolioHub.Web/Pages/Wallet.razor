@page "/carteiras/{WalletId:guid}"
@inherits WalletPage

<PageTitle>@(wallet?.Name ?? "Carteira") | PortfolioHub</PageTitle>

<a href=""
   class="mb-6 inline-flex items-center gap-1 rounded text-sm font-medium text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
    <span aria-hidden="true">←</span> Carteiras
</a>

@switch (state)
{
    case LoadState.WalletNotFound:
        <section class="rounded-xl border border-line bg-surface p-6 sm:p-8">
            <h1 class="text-xl font-semibold">Carteira não encontrada</h1>
            <p class="mt-2 text-sm text-muted">Ela pode ter sido removida ou o endereço está incorreto.</p>
            <a href="" class="mt-6 inline-block text-sm font-medium text-link underline underline-offset-4">Ver todas as
                carteiras</a>
            </section>
            break;

    case LoadState.Error:
                <ApiErrorNotice Title="Não foi possível carregar a carteira" OnRetry="LoadAsync" />
                break;

            case LoadState.Loading:
                <div class="animate-pulse" role="status" aria-label="Carregando carteira">
                    <div class="h-4 w-32 rounded bg-line"></div>
                    <div class="mt-3 h-8 w-56 rounded bg-line"></div>
                    <div class="mt-8 grid gap-4 md:grid-cols-3">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="h-36 rounded-xl border border-line bg-surface"></div>
                        }
                    </div>
                    <div class="mt-6 h-40 rounded-xl border border-line bg-surface"></div>
                    <div class="mt-6 h-72 rounded-xl border border-line bg-surface"></div>
                </div>
                break;

            case LoadState.Loaded:
                <header class="mb-8">
                    <p class="text-xs font-semibold uppercase tracking-widest text-muted">Carteira</p>
                    <h1 class="mt-2 text-3xl font-semibold tracking-tight">@wallet!.Name</h1>
                </header>

                <section aria-label="Resumo da carteira" class="grid gap-4 md:grid-cols-3">
                    <StatCard Title="Patrimônio atual" Value="@NetWorth.ToString("C")">
                        <Detail>@AssetCountLabel</Detail>
                    </StatCard>

                    <StatCard Title="Resultado" Value="@FormatSigned(Result)"
                              ValueClass="@(Result >= 0 ? "text-success" : "text-danger")">
                        <Detail>Sobre @NetInvested.ToString("C") investidos (compras − vendas)</Detail>
                    </StatCard>

                    <StatCard Title="Dividendos recebidos" Value="@dividends.TotalReceived.ToString("C")">
                        <Detail>@DividendCountLabel</Detail>
                    </StatCard>
                </section>

                @if (positions.Count == 0)
                {
                    <section class="mt-6 rounded-xl border border-dashed border-line bg-surface p-10 text-center">
                        <h2 class="text-lg font-semibold">Sua carteira ainda está vazia</h2>
                        <p class="mt-2 text-sm text-muted">Quando você registrar uma compra, as posições e a distribuição aparecem aqui.</p>
                    </section>
                }
                else
                {
                    <div class="mt-6">
                        <AllocationBar Slices="allocation" />
                    </div>

                    <section class="mt-6 rounded-xl border border-line bg-surface" aria-labelledby="positions-title">
                        <h2 id="positions-title" class="px-6 pt-6 text-lg font-semibold">Posições</h2>

                        <div class="mt-4 overflow-x-auto">
                            <table class="w-full min-w-160 text-sm">
                                <thead>
                                    <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-muted">
                                        <th scope="col" class="px-6 py-3 font-medium">Ativo</th>
                                        <th scope="col" class="px-3 py-3 font-medium">Classe</th>
                                        <th scope="col" class="px-3 py-3 text-right font-medium">Quantidade</th>
                                        <th scope="col" class="px-3 py-3 text-right font-medium">Preço atual</th>
                                        <th scope="col" class="px-3 py-3 text-right font-medium">Valor</th>
                                        <th scope="col" class="px-6 py-3 text-right font-medium">% da carteira</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var position in positions)
                                    {
                                        var assetClass = ClassOf(position.AssetId);
                                        var share = NetWorth == 0 ? 0 : position.Total / NetWorth;

                                        <tr class="border-b border-line last:border-0 hover:bg-page">
                                            <td class="px-6 py-4">
                                                <p class="font-semibold">@position.Ticker</p>
                                                <p class="text-xs text-muted">@position.AssetName</p>
                                            </td>
                                            <td class="px-3 py-4">
                                                <span class="inline-flex items-center gap-2 whitespace-nowrap">
                                                    <span class="@($"{assetClass.ColorClass} size-2.5 rounded-sm")" aria-hidden="true"></span>
                                                    @assetClass.Label
                                                </span>
                                            </td>
                                            <td class="px-3 py-4 text-right tabular-nums">@FormatQuantity(position.Quantity)</td>
                                            <td class="px-3 py-4 text-right tabular-nums">@position.MarketPrice.ToString("C")</td>
                                            <td class="px-3 py-4 text-right font-medium tabular-nums">@position.Total.ToString("C")</td>
                                            <td class="px-6 py-4 text-right tabular-nums">@share.ToString("P1")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                <div class="mt-6 grid gap-6 lg:grid-cols-2">
                    <section class="rounded-xl border border-line bg-surface p-6" aria-labelledby="transactions-title">
                        <h2 id="transactions-title" class="text-lg font-semibold">Últimas movimentações</h2>

                        @if (transactions.Count == 0)
                        {
                            <p class="mt-4 text-sm text-muted">Nenhuma compra ou venda registrada.</p>
                        }
                        else
                        {
                            <ul class="mt-4 divide-y divide-line">
                                @foreach (var transaction in transactions.OrderByDescending(t => t.Date).Take(RecentItems))
                                {
                                    <li class="flex items-center justify-between gap-4 py-3">
                                        <div class="min-w-0">
                                            <p class="text-sm">
                                                <span
                                                    class="@(transaction.IsBuy ? "bg-primary/10 text-primary" : "bg-link/10 text-link") mr-2 rounded px-1.5 py-0.5 text-xs font-semibold">
                                                    @(transaction.IsBuy ? "Compra" : "Venda")
                                                </span>
                                                <span class="font-semibold">@transaction.Ticker</span>
                                            </p>
                                            <p class="mt-1 text-xs text-muted tabular-nums">
                                                @FormatQuantity(transaction.Quantity) × @transaction.UnitPrice.ToString("C") ·
                                                @transaction.Date.ToLocalTime().ToString("dd/MM/yyyy")
                                            </p>
                                        </div>
                                        <p class="shrink-0 text-sm font-medium tabular-nums">@transaction.Total.ToString("C")</p>
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    <section class="rounded-xl border border-line bg-surface p-6" aria-labelledby="dividends-title">
                        <h2 id="dividends-title" class="text-lg font-semibold">Últimos dividendos</h2>

                        @if (dividends.Dividends.Count == 0)
                        {
                            <p class="mt-4 text-sm text-muted">Nenhum dividendo recebido ainda.</p>
                        }
                        else
                        {
                            <ul class="mt-4 divide-y divide-line">
                                @foreach (var dividend in dividends.Dividends.OrderByDescending(d => d.Date).Take(RecentItems))
                                {
                                    <li class="flex items-center justify-between gap-4 py-3">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold">@dividend.Ticker</p>
                                            <p class="mt-1 text-xs text-muted tabular-nums">
                                                @FormatQuantity(dividend.Quantity) × @dividend.ValuePerShare.ToString("C") ·
                                                @dividend.Date.ToString("dd/MM/yyyy")
                                            </p>
                                        </div>
                                        <p class="shrink-0 text-sm font-medium text-success tabular-nums">+@dividend.Total.ToString("C")</p>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>
                break;
            }
