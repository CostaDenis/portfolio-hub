@page "/wallets/{WalletId:guid}"
@inherits WalletPage

<PageTitle>@(wallet?.Name ?? "Carteira") | PortfolioHub</PageTitle>

<a href=""
   class="mb-6 inline-flex items-center gap-1 rounded text-sm font-medium text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
    Carteiras
</a>

@switch (state)
{
    case LoadState.WalletNotFound:
        <section class="rounded-xl border border-line bg-surface p-6 sm:p-8">
            <h1 class="text-xl font-semibold">Carteira não encontrada</h1>
            <p class="mt-2 text-sm text-muted">Ela pode ter sido removida ou o endereço está incorreto.</p>
            <a href="" class="mt-6 inline-block text-sm font-medium text-link underline underline-offset-4">Ver todas as
                carteiras</a>
            </section>
            break;

    case LoadState.Error:
                <ApiErrorNotice Title="Não foi possível carregar a carteira" OnRetry="LoadAsync" />
                break;

            case LoadState.Loading:
                <div class="animate-pulse" role="status" aria-label="Carregando carteira">
                    <div class="h-4 w-32 rounded bg-line"></div>
                    <div class="mt-3 h-8 w-56 rounded bg-line"></div>
                    <div class="mt-8 grid gap-4 md:grid-cols-3">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="h-36 rounded-xl border border-line bg-surface"></div>
                        }
                    </div>
                    <div class="mt-6 h-40 rounded-xl border border-line bg-surface"></div>
                    <div class="mt-6 h-72 rounded-xl border border-line bg-surface"></div>
                </div>
                break;

            case LoadState.Loaded:
                <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Carteira</p>

                        @if (renaming)
                        {
                            <h1 class="sr-only">@wallet!.Name</h1>

                            <form class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-start" @onsubmit="SaveNameAsync"
                                  @onsubmit:preventDefault>
                                <div class="w-full sm:w-80">
                                    <label for="wallet-rename" class="sr-only">Novo nome da carteira</label>
                                    <input id="wallet-rename" @ref="renameInput" @bind="newWalletName" @bind:event="oninput"
                                           @onkeydown="OnRenameKeyDown" maxlength="20" autocomplete="off"
                                           aria-invalid="@AriaBool(renameError is not null)" aria-describedby="wallet-rename-help"
                                           class="w-full rounded-lg border border-line bg-surface px-3 py-2 text-2xl font-semibold tracking-tight text-ink focus:border-link focus:outline-2 focus:outline-link aria-invalid:border-danger" />
                                    @if (renameError is not null)
                                    {
                                        <p id="wallet-rename-help" class="mt-2 text-sm text-danger" role="alert">@renameError</p>
                                    }
                                    else
                                    {
                                        <p id="wallet-rename-help" class="mt-2 text-xs text-muted">Entre 2 e 20 caracteres. Esc cancela.</p>
                                    }
                                </div>

                                <div class="flex gap-3">
                                    <button type="submit" disabled="@savingName"
                                            class="hover:cursor-pointer rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-surface transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-60">
                                        @(savingName ? "Salvando…" : "Salvar")
                                    </button>
                                    <button type="button" @onclick="CloseRename"
                                            class="hover:cursor-pointer rounded-lg px-5 py-3 text-sm font-medium text-muted transition-colors hover:bg-line/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
                                        Cancelar
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                                <h1 class="wrap-break-words text-3xl font-semibold tracking-tight">@wallet!.Name</h1>
                                <button type="button" @ref="renameButton" @onclick="OpenRename" aria-label="Renomear carteira @wallet.Name"
                                        class="hover:cursor-pointer inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium text-link transition-colors hover:bg-line/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link">
                                    Renomear
                                </button>
                            </div>
                        }
                    </div>

                    @if (!operationOpen)
                    {
                        <button type="button" @onclick="OpenOperation"
                                class="hover:cursor-pointer rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-surface transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
                            Nova operação
                        </button>
                    }
                </header>

                <p role="status"
                   class="@(statusMessage is null ? "sr-only" : "mb-6 rounded-lg bg-success/10 px-4 py-3 text-sm text-success")">
                    @statusMessage</p>

                    @if (operationOpen)
                    {
                        <section class="mb-6 rounded-xl border border-line bg-surface p-6" aria-labelledby="operation-title">
                            <h2 id="operation-title" class="text-lg font-semibold">Nova operação</h2>

                            <div class="mt-4 inline-flex rounded-lg border border-line bg-page p-1" role="group" aria-label="Tipo de operação">
                                @foreach (var option in OperationTypes)
                                {
                                    var active = operationType == option.Type;
                                    <button type="button" @onclick="() => SetOperationType(option.Type)" aria-pressed="@AriaBool(active)"
                                            class="@($"hover:cursor-pointer rounded-md px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link {(active ? "bg-surface text-ink shadow-sm" : "text-muted hover:text-ink")}")">
                                        @option.Label
                                    </button>
                                }
                            </div>

                            @if (OperationAssetOptions.Count == 0)
                            {
                                <div class="mt-5 rounded-lg border border-dashed border-line p-6 text-center">
                                    @if (operationType == OperationType.Buy)
                                    {
                                        <p class="font-medium">Nenhum ativo cadastrado</p>
                                        <p class="mt-1 text-sm text-muted">
                                            Cadastre o ativo antes de registrar a compra, na página
                                            <a href="assets" class="font-medium text-link underline underline-offset-4">Ativos</a>.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="font-medium">Nenhum ativo nesta carteira</p>
                                        <p class="mt-1 text-sm text-muted">
                                            @(operationType == OperationType.Sell ? "Só é possível vender" : "Só é possível receber dividendos de")
                                            ativos que você já comprou nesta carteira.
                                        </p>
                                    }
                                </div>

                                <button type="button" @onclick="CloseOperation"
                                        class="hover:cursor-pointer mt-5 rounded-lg px-5 py-3 text-sm font-medium text-muted transition-colors hover:bg-line/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
                                    Cancelar
                                </button>
                            }
                            else
                            {
                                <form class="mt-5" @onsubmit="SubmitOperationAsync" @onsubmit:preventDefault novalidate>
                                    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                        <div class="sm:col-span-2 lg:col-span-1">
                                            <label for="operation-asset" class="block text-sm font-medium">Ativo</label>
                                            <select id="operation-asset" @bind="operationAssetId"
                                                    class="hover:cursor-pointer mt-2 w-full rounded-lg border border-line bg-page px-4 py-3 text-ink focus:border-link focus:outline-2 focus:outline-link">
                                                <option value="">Selecione um ativo</option>
                                                @foreach (var option in OperationAssetOptions)
                                                {
                                                    <option value="@option.AssetId">@option.Label</option>
                                                }
                                            </select>
                                        </div>

                                        @if (operationType == OperationType.Dividend)
                                        {
                                            <div>
                                                <label for="operation-price" class="block text-sm font-medium">Valor por cota</label>
                                                <div class="relative mt-2">
                                                    <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm text-muted"
                                                          aria-hidden="true">R$</span>
                                                    <input id="operation-price" type="number" @bind="operationPrice" @bind:event="oninput" min="0"
                                                           step="any" inputmode="decimal" placeholder="0,00"
                                                           class="w-full rounded-lg border border-line bg-page py-3 pr-4 pl-11 text-ink tabular-nums placeholder:text-muted focus:border-link focus:outline-2 focus:outline-link" />
                                                </div>
                                            </div>

                                            <div>
                                                <label for="operation-date" class="block text-sm font-medium">Data do pagamento</label>
                                                <input id="operation-date" type="date" @bind="operationDate"
                                                       class="mt-2 w-full rounded-lg border border-line bg-page px-4 py-3 text-ink focus:border-link focus:outline-2 focus:outline-link" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <label for="operation-quantity" class="block text-sm font-medium">Quantidade</label>
                                                <input id="operation-quantity" type="number" @bind="operationQuantity" @bind:event="oninput" min="0"
                                                       step="any" inputmode="decimal" placeholder="0"
                                                       class="mt-2 w-full rounded-lg border border-line bg-page px-4 py-3 text-ink tabular-nums placeholder:text-muted focus:border-link focus:outline-2 focus:outline-link" />
                                                @if (operationType == OperationType.Sell && operationAssetId is not null)
                                                {
                                                    <p class="mt-2 text-xs text-muted">Disponível: <span
                                                        class="tabular-nums">@FormatQuantity(HeldQuantity)</span></p>
                                                    }
                                                </div>

                                                <div>
                                                    <label for="operation-price" class="block text-sm font-medium">Preço unitário</label>
                                                    <div class="relative mt-2">
                                                        <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm text-muted"
                                                              aria-hidden="true">R$</span>
                                                        <input id="operation-price" type="number" @bind="operationPrice" @bind:event="oninput" min="0"
                                                               step="any" inputmode="decimal" placeholder="0,00"
                                                               class="w-full rounded-lg border border-line bg-page py-3 pr-4 pl-11 text-ink tabular-nums placeholder:text-muted focus:border-link focus:outline-2 focus:outline-link" />
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <p class="mt-5 text-sm text-muted" aria-live="polite">
                                            @if (OperationTotal is { } total)
                                            {
                                                @(operationType == OperationType.Dividend
                                                    ? $"Total a receber ({FormatQuantity(HeldQuantity)} cotas): "
                                                    : "Total da operação: ")
                                                <span class="font-semibold text-ink tabular-nums">@total.ToString("C")</span>
                                            }
                                            else
                                            {
                                                @("O total aparece aqui conforme você preenche.")
                                            }
                                        </p>

                                        @if (operationError is not null)
                                        {
                                            <p class="mt-4 rounded-lg bg-danger/10 px-4 py-3 text-sm text-danger" role="alert">@operationError</p>
                                        }

                                        <div class="mt-6 flex flex-wrap gap-3">
                                            <button type="submit" disabled="@savingOperation"
                                                    class="hover:cursor-pointer disabled:cursor-not-allowed disabled:opacity-60 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-surface transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
                                                @SubmitLabel
                                            </button>
                                            <button type="button" @onclick="CloseOperation"
                                                    class="hover:cursor-pointer rounded-lg px-5 py-3 text-sm font-medium text-muted transition-colors hover:bg-line/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
                                                Cancelar
                                            </button>
                                        </div>
                                    </form>
                                }
                            </section>
                        }

                        <section aria-label="Resumo da carteira" class="grid gap-4 md:grid-cols-3">
                            <StatCard Title="Patrimônio atual" Value="@NetWorth.ToString("C")">
                                <Detail>@AssetCountLabel</Detail>
                            </StatCard>

                            <StatCard Title="Resultado" Value="@FormatSigned(Result)"
                                      ValueClass="@(Result >= 0 ? "text-success" : "text-danger")">
                                <Detail>Sobre @NetInvested.ToString("C") investidos (compras − vendas)</Detail>
                            </StatCard>

                            <StatCard Title="Dividendos recebidos" Value="@dividends.TotalReceived.ToString("C")">
                                <Detail>@DividendCountLabel</Detail>
                            </StatCard>
                        </section>

                        @if (positions.Count == 0)
                        {
                            <section class="mt-6 rounded-xl border border-dashed border-line bg-surface p-10 text-center">
                                <h2 class="text-lg font-semibold">Sua carteira ainda está vazia</h2>
                                <p class="mt-2 text-sm text-muted">Quando você registrar uma compra, as posições e a distribuição aparecem aqui.</p>
                            </section>
                        }
                        else
                        {
                            <div class="mt-6">
                                <AllocationBar Slices="allocation" />
                            </div>

                            <section class="mt-6 rounded-xl border border-line bg-surface" aria-labelledby="positions-title">
                                <h2 id="positions-title" class="px-6 pt-6 text-lg font-semibold">Posições</h2>

                                <div class="mt-4 overflow-x-auto">
                                    <table class="w-full min-w-160 text-sm">
                                        <thead>
                                            <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-muted">
                                                <th scope="col" class="px-6 py-3 font-medium">Ativo</th>
                                                <th scope="col" class="px-3 py-3 font-medium">Classe</th>
                                                <th scope="col" class="px-3 py-3 text-right font-medium">Quantidade</th>
                                                <th scope="col" class="px-3 py-3 text-right font-medium">Preço atual</th>
                                                <th scope="col" class="px-3 py-3 text-right font-medium">Valor</th>
                                                <th scope="col" class="px-6 py-3 text-right font-medium">% da carteira</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var position in positions)
                                            {
                                                var assetClass = ClassOf(position.AssetId);
                                                var share = NetWorth == 0 ? 0 : position.Total / NetWorth;

                                                <tr class="border-b border-line last:border-0 hover:bg-page">
                                                    <td class="px-6 py-4">
                                                        <p class="font-semibold">@position.Ticker</p>
                                                        <p class="text-xs text-muted">@position.AssetName</p>
                                                    </td>
                                                    <td class="px-3 py-4">
                                                        <span class="inline-flex items-center gap-2 whitespace-nowrap">
                                                            <span class="@($"{assetClass.ColorClass} size-2.5 rounded-sm")" aria-hidden="true"></span>
                                                            @assetClass.Label
                                                        </span>
                                                    </td>
                                                    <td class="px-3 py-4 text-right tabular-nums">@FormatQuantity(position.Quantity)</td>
                                                    <td class="px-3 py-4 text-right tabular-nums">@PriceFormatter.Format(position.MarketPrice)</td>
                                                    <td class="px-3 py-4 text-right font-medium tabular-nums">@position.Total.ToString("C")</td>
                                                    <td class="px-6 py-4 text-right tabular-nums">@share.ToString("P1")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }

                        <div class="mt-6 grid gap-6 lg:grid-cols-2">
                            <section class="rounded-xl border border-line bg-surface p-6" aria-labelledby="transactions-title">
                                <div class="flex items-baseline justify-between gap-4">
                                    <h2 id="transactions-title" class="text-lg font-semibold">Últimas movimentações</h2>
                                    @if (transactions.Count > 0)
                                    {
                                        <a href="wallets/@WalletId/history" aria-label="Ver todas as movimentações"
                                           class="shrink-0 rounded text-sm font-medium text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
                                            Ver todas
                                        </a>
                                    }
                                </div>

                                @if (transactions.Count == 0)
                                {
                                    <p class="mt-4 text-sm text-muted">Nenhuma compra ou venda registrada.</p>
                                }
                                else
                                {
                                    <ul class="mt-4 divide-y divide-line">
                                        @foreach (var transaction in transactions.OrderByDescending(t => t.Date).Take(RecentItems))
                                        {
                                            <li class="flex items-center justify-between gap-4 py-3">
                                                <div class="min-w-0">
                                                    <p class="text-sm">
                                                        <span
                                                            class="@(transaction.IsBuy ? "bg-primary/10 text-primary" : "bg-link/10 text-link") mr-2 rounded px-1.5 py-0.5 text-xs font-semibold">
                                                            @(transaction.IsBuy ? "Compra" : "Venda")
                                                        </span>
                                                        <span class="font-semibold">@transaction.Ticker</span>
                                                    </p>
                                                    <p class="mt-1 text-xs text-muted tabular-nums">
                                                        @FormatQuantity(transaction.Quantity) × @PriceFormatter.Format(transaction.UnitPrice) ·
                                                        @transaction.Date.ToLocalTime().ToString("dd/MM/yyyy")
                                                    </p>
                                                </div>
                                                <p class="shrink-0 text-sm font-medium tabular-nums">@transaction.Total.ToString("C")</p>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>

                            <section class="rounded-xl border border-line bg-surface p-6" aria-labelledby="dividends-title">
                                <div class="flex items-baseline justify-between gap-4">
                                    <h2 id="dividends-title" class="text-lg font-semibold">Últimos dividendos</h2>
                                    @if (dividends.Dividends.Count > 0)
                                    {
                                        <a href="wallets/@WalletId/history?type=dividends" aria-label="Ver todos os dividendos"
                                           class="shrink-0 rounded text-sm font-medium text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link">
                                            Ver todos <span aria-hidden="true">→</span>
                                        </a>
                                    }
                                </div>

                                @if (dividends.Dividends.Count == 0)
                                {
                                    <p class="mt-4 text-sm text-muted">Nenhum dividendo recebido ainda.</p>
                                }
                                else
                                {
                                    <ul class="mt-4 divide-y divide-line">
                                        @foreach (var dividend in dividends.Dividends.OrderByDescending(d => d.Date).Take(RecentItems))
                                        {
                                            <li class="flex items-center justify-between gap-4 py-3">
                                                <div class="min-w-0">
                                                    <p class="text-sm font-semibold">@dividend.Ticker</p>
                                                    <p class="mt-1 text-xs text-muted tabular-nums">
                                                        @FormatQuantity(dividend.Quantity) × @PriceFormatter.Format(dividend.ValuePerShare) ·
                                                        @dividend.Date.ToString("dd/MM/yyyy")
                                                    </p>
                                                </div>
                                                <p class="shrink-0 text-sm font-medium text-success tabular-nums">+@dividend.Total.ToString("C")</p>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        </div>
                        break;
                    }
